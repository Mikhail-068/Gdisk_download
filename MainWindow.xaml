<Window x:Class="DriveDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriveDownload"
        Title="{local:Translate AppTitle}" Width="960" Height="770" MinWidth="680" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="TranslucentPanelBrush" Color="#D21D1F22"/>
  </Window.Resources>
  <Grid>
    <Grid MaxWidth="880" Margin="28,16,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="1,4,0,17">
        <Button x:Name="LanguageButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                Margin="12,0,0,0" MinWidth="116" MinHeight="34" Padding="12,6"
                ToolTip="{local:Translate Language}" AutomationProperties.Name="{local:Translate Language}"
                Click="OpenLanguageMenu">
          <Button.ContextMenu>
            <ContextMenu Placement="Bottom" Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource Rule}"
                         BorderThickness="1" Padding="4" MinWidth="116" Opened="LanguageMenuOpened">
              <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                          CornerRadius="10">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </Border>
                </ControlTemplate>
              </ContextMenu.Template>
              <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="9,6">
                          <DockPanel TextBlock.Foreground="{StaticResource TextBrush}">
                            <Path x:Name="SelectedMark" DockPanel.Dock="Right" Data="M1,5 L4,8 L9,2"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.6" Margin="8,0,0,0"
                                  VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter ContentSource="Header"/>
                          </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{StaticResource ControlBrush}"/>
                          </Trigger>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ContextMenu.Resources>
              <MenuItem Header="Русский" Tag="ru" IsCheckable="True" Click="SelectLanguage"/>
              <MenuItem Header="English" Tag="en" IsCheckable="True" Click="SelectLanguage"/>
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse Width="15" Height="15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
              <Ellipse Width="7" Height="15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
              <Path Data="M1,8 H15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
            </Grid>
            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/>
            <Path Data="M1,2 L5,6 L9,2" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4"
                  Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal">
          <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource ControlBrush}"
                  Margin="0,0,13,0" BorderBrush="{StaticResource Rule}" BorderThickness="1">
            <Image Name="DriveMark" Source="pack://application:,,,/DriveDownload;component/Assets/GoogleDrive.png"
                   Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center"
                   ToolTip="{local:Translate DriveSource}" AutomationProperties.Name="Google Drive"/>
          </Border>
          <StackPanel>
            <TextBlock Text="{local:Translate AppTitle}" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="{local:Translate AppSubtitle}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Name="SetupPanel" Background="{StaticResource TranslucentPanelBrush}" CornerRadius="19"
              BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" Padding="19" Margin="0,0,0,15">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Label Grid.ColumnSpan="2" Target="{Binding ElementName=Link}" Content="{local:Translate FolderLink}"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <TextBox Name="Link" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     AutomationProperties.Name="{local:Translate FolderLink}"/>
            <TextBlock Text="https://drive.google.com/drive/folders/…" Margin="11,0,0,0" IsHitTestVisible="False"
                       VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                       Foreground="{StaticResource Muted}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Link}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Label Grid.Row="2" Target="{Binding ElementName=Destination}" Content="{local:Translate SaveTo}" Margin="0,11,0,0"/>
          <TextBox Grid.Row="3" Name="Destination" AutomationProperties.Name="{local:Translate Destination}" Margin="0,0,9,0"/>
          <Button Grid.Row="3" Grid.Column="1" Name="Browse" Click="BrowseClick" MinWidth="48" Padding="10,7"
                  ToolTip="{local:Translate BrowseTip}" AutomationProperties.Name="{local:Translate Browse}">
            <Path Width="23" Height="21" Stretch="Uniform"
                  Data="{StaticResource FolderIcon}" Fill="{StaticResource WarningBrush}"/>
          </Button>
          <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Name="ChooseFiles" Click="ChooseFilesClick" Margin="0,0,9,0" MinWidth="48" MinHeight="43" Padding="10,7"
                    ToolTip="{local:Translate ChooseFilesTip}" AutomationProperties.Name="{local:Translate ChooseFiles}">
              <Path Width="23" Height="21" Stretch="Uniform"
                    Data="{StaticResource ChecklistIcon}" Fill="{StaticResource Accent}"/>
            </Button>
            <Button Grid.Column="1" Name="Start" Click="StartClick" Content="{local:Translate DownloadAll}" Tag="{StaticResource DownloadIcon}"
                    Style="{StaticResource GlossyButton}" MinHeight="43"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="1" Name="ActivePanel" Visibility="Collapsed"
              Background="{StaticResource TranslucentPanelBrush}" BorderBrush="{StaticResource PanelEdgeBrush}"
              BorderThickness="1" CornerRadius="13" Padding="15,11" Margin="0,0,0,15">
        <StackPanel>
          <TextBlock Text="{local:Translate LocalFolder}" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBlock Name="ActivePath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource TranslucentPanelBrush}" CornerRadius="19"
              BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" Padding="19">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Name="Percent" Text="0%" FontSize="41" FontWeight="SemiBold"
                       VerticalAlignment="Center" AutomationProperties.Name="{local:Translate ProgressPercent}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
              <TextBlock Name="Summary" Text="{local:Translate InitialSummary}" FontWeight="SemiBold" TextAlignment="Right"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" TextTrimming="CharacterEllipsis"/>
              <TextBlock Name="TransferRate" Text="{local:Translate InitialRate}" Foreground="{StaticResource Muted}"
                         TextAlignment="Right" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
          </Grid>
          <ProgressBar Grid.Row="1" Name="Overall" Minimum="0" Maximum="100" Height="13"
                       Style="{StaticResource TransferBar}" Foreground="{StaticResource TransferGradient}"
                       AutomationProperties.Name="{local:Translate OverallProgress}"/>
          <Grid Grid.Row="2" Margin="0,12,0,11">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="Pause" Tag="{StaticResource PauseIcon}" Click="PauseClick" Content="{local:Translate Pause}" IsEnabled="False" Padding="13,6" MinHeight="32"/>
            <TextBlock Grid.Column="1" Name="StatusBar" Text="{local:Translate EnterLink}" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="11,0" MaxHeight="42"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Column="2" Name="OpenFolder" Click="OpenFolderClick" AutomationProperties.Name="{local:Translate OpenFolder}"
                    IsEnabled="False" Padding="13,6" MinHeight="32">
              <StackPanel Orientation="Horizontal">
                <Path Width="17" Height="16" Stretch="Uniform" Data="{StaticResource OpenFolderIcon}"
                      Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{local:Translate OpenFolder}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0">
            <Grid>
              <DataGrid Name="Queue" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        RowHeight="40" Background="Transparent" RowStyle="{StaticResource QueueRow}"
                        AlternationCount="2" FontSize="13"
                        Foreground="{StaticResource TextBrush}" GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="{StaticResource GridLineBrush}" BorderThickness="0"
                        CanUserAddRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#30496B"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#283951"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8EAED"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8EAED"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{local:Translate File}" Width="*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Path Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Style="{StaticResource FileIconStyle}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource CellText}"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Translate Downloaded}" Width="164">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                          <TextBlock Text="{Binding Amount}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                          <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource TransferBar}"
                                       Foreground="{Binding ProgressTone}" AutomationProperties.Name="{local:Translate FileProgress}"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{local:Translate Status}" Binding="{Binding Status}" Width="169" ElementStyle="{StaticResource StatusText}"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Name="Empty" Text="{local:Translate EmptyQueuePrompt}" Foreground="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,29,0,0"/>
            </Grid>
          </Border>
          <TextBlock Grid.Row="4" Name="QueueSummary" Text="{local:Translate EmptyQueue}" Foreground="{StaticResource Muted}"
                     FontSize="12" Margin="10,9,0,0"/>
        </Grid>
      </Border>

      <Button Grid.Row="3" Name="Account" Click="AccountClick" HorizontalAlignment="Right"
              Margin="0,8,0,0" Padding="11,4" MinHeight="29" FontSize="12"
              ToolTip="{local:Translate AccessSettings}"
              AutomationProperties.Name="{Binding Text, ElementName=AccountStatus}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Name="AccountLamp" Fill="{StaticResource ErrorBrush}" Width="8" Height="8"
                   VerticalAlignment="Center" Margin="0,0,7,0"/>
          <TextBlock Name="AccountStatus" Text="{local:Translate NotConnected}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>